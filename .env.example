# Secrets only. Copy to .env and fill in; .env is never committed.
# Docker Compose passes these to the collector and api containers.

# Needed only when config.yaml has triage.client: claude.
# With triage.client: mock (the default in config.example.yaml) leave it empty.
ANTHROPIC_API_KEY=

# Cloudflare tunnel (optional). Uncomment COMPOSE_PROFILES to start the cloudflared
# service, set the tunnel's UUID, and put its credentials JSON at secrets/cloudflared.json.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_ID=
