# Secrets only. Copy to .env and fill in; .env is never committed.
# Docker Compose passes these to the collector and api containers.

# Needed only when config.yaml has triage.client: claude.
# With triage.client: mock (the default in config.example.yaml) leave it empty.
ANTHROPIC_API_KEY=

# Cloudflare tunnel (optional). Uncomment COMPOSE_PROFILES to start the cloudflared
# service, set the tunnel's UUID, and put its credentials JSON at secrets/cloudflared.json.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_ID=

# Dashboard (DD-16): its own API key, from `docker compose exec api python -m sec450.keys create`.
DASHBOARD_API_KEY=

# Dashboard tunnel (optional). Add dashboard-tunnel to COMPOSE_PROFILES, set the tunnel's
# UUID, and put its credentials JSON at secrets/cloudflared-dashboard.json.
DASHBOARD_TUNNEL_ID=
# The dashboard's public address, e.g. https://dash.example.com (its websocket is refused otherwise).
DASHBOARD_PUBLIC_ORIGIN=
