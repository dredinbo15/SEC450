# Files that run inside Linux containers must keep LF line endings, even when
# checked out on Windows (a CRLF shell script fails with "bad interpreter").
*.sh          text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
*.conf        text eol=lf
# Fixture logs are compared byte for byte in tests.
tests/fixtures/** text eol=lf
